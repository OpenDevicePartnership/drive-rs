{%- assign has_registers = false -%}
{%- if interfaces contains "i2c" or interfaces contains "spi" -%}{%- assign has_registers = true -%}{%- endif -%}
// device-driver DDSL manifest for the {{ project-name | pascal_case }}.
//
// This is the single source of truth for the register map. Edit it to match
// your device's datasheet, then regenerate `src/registers.rs` with:
//
//     ddc build rust -s device.ddsl -o src/registers.rs --rust-defmt-feature=defmt
//
// (`cargo install device-driver-cli` if you don't have `ddc`.)

device {{ project-name | pascal_case }}Registers {
{% if has_registers %}    register-address-type: u8,
{% endif %}{% if interfaces contains "uart" %}    buffer-address-type: u8,
{% endif %}    default-byte-order: LE,
    default-access: RW,
{% if has_registers %}
    /// Read-only device identification register.
    register DeviceId {
        address: 0,
        access: RO,
        fields: fieldset _ {
            size-bytes: 1,

            /// Fixed identifier reported by the device.
            field id 7:0,
        },
    },
    /// Primary configuration register.
    register Config {
        address: 1,
        reset: 0,
        fields: fieldset _ {
            size-bytes: 1,

            /// Enable the device.
            field enable 0,
            /// Operating mode (0..=3).
            field mode 2:1,
        },
    },
{% endif %}{% if interfaces contains "uart" %}
    /// Raw byte stream to and from the device. Whatever framing the device
    /// speaks over the wire is decoded in `src/driver.rs`, not here.
    buffer Stream {
        access: RW,
        address: 0,
    },
{% endif %}}